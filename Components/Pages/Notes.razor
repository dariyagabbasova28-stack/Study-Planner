@page "/notes"
@rendermode InteractiveServer

@using StudyMate.Models
@using StudyMate.Services
@using System.Globalization

@inject NoteService NoteService

<PageTitle>Study Notes - StudyMate</PageTitle>

<div class="notes-page">

    <div class="notes-header">
        <div>
            <h2>📝 Study Notes</h2>
            <p>Capture ideas, organize knowledge, and study smarter.</p>
        </div>

        <button class="notes-primary" @onclick="ShowAddForm">
            + New Note
        </button>
    </div>

    <div class="notes-stats">
        <div class="notes-stat">
            <span>📚</span>
            <div>
                <small>Total Notes</small>
                <h3>@notes.Count</h3>
            </div>
        </div>

        <div class="notes-stat">
            <span>📖</span>
            <div>
                <small>Subjects</small>
                <h3>@SubjectCount</h3>
            </div>
        </div>

        <div class="notes-stat">
            <span>✏️</span>
            <div>
                <small>Recently Updated</small>
                <h3>@RecentlyUpdatedCount</h3>
            </div>
        </div>
    </div>

    @if (showForm)
    {
        <div class="notes-form-card">

            <div class="notes-form-header">
                <h3>@(isEditing ? "✏️ Edit Note" : "✨ Create New Note")</h3>

                <button class="notes-close" @onclick="CancelEdit">
                    ✕
                </button>
            </div>

            <EditForm Model="noteForm"
                      OnValidSubmit="SaveNote"
                      FormName="noteForm">

                <DataAnnotationsValidator />
                <ValidationSummary />

                <div class="notes-field">
                    <label>Note Title</label>

                    <InputText class="form-control"
                               @bind-Value="noteForm.Title"
                               placeholder="Enter note title" />
                </div>

                <div class="notes-field">
                    <label>Subject</label>

                    <InputText class="form-control"
                               @bind-Value="noteForm.Subject"
                               placeholder="e.g. Computer Science" />
                </div>

                <div class="notes-field">
                    <label>Content</label>

                    <InputTextArea class="form-control"
                                   @bind-Value="noteForm.Content"
                                   placeholder="Write your study notes here..."
                                   rows="8" />
                </div>

                <div class="notes-form-actions">

                    <button type="submit" class="notes-primary">
                        @(isEditing ? "Save Changes" : "Create Note")
                    </button>

                    <button type="button"
                            class="notes-secondary"
                            @onclick="CancelEdit">
                        Cancel
                    </button>

                </div>

            </EditForm>

        </div>
    }

    <div class="notes-toolbar">

        <div>
            <h3>Your Notes</h3>
            <p>@FilteredNotes.Count() notes found</p>
        </div>

        <input class="notes-search"
               placeholder="🔍 Search notes..."
               @bind="searchText"
               @bind:event="oninput" />

    </div>

    @if (!FilteredNotes.Any())
    {
        <div class="notes-empty">
            <div>📭</div>
            <h4>No notes found</h4>
            <p>Create your first note or try another search.</p>
        </div>
    }
    else
    {
        <div class="notes-grid">

            @foreach (var note in FilteredNotes)
            {
                <div class="note-card">

                    <div class="note-card-top">
                        <span class="note-icon">📒</span>

                        <span class="note-subject">
                            @(string.IsNullOrWhiteSpace(note.Subject)
                                                ? "General"
                                                : note.Subject)
                </span>
            </div>

                    <h4>@note.Title</h4>

                    <p class="note-preview">
                        @GetPreview(note.Content)
                    </p>

                    <div class="note-date">
                        🕒 Updated:
                        @note.UpdatedAt.ToString(
                                "dd MMM yyyy",
                                CultureInfo.GetCultureInfo("en-US"))
            </div>

            <div class="note-actions">

                <button class="note-edit"
                        @onclick="() => EditNote(note)">
                    ✏️ Edit
                </button>

                <button class="note-delete"
                        @onclick="() => RequestDelete(note.Id)">
                    🗑️ Delete
                </button>

            </div>

        </div>
                }

        </div>
    }

    @if (noteToDelete.HasValue)
    {
        <div class="notes-modal-overlay">

            <div class="notes-modal">
                <div class="notes-modal-icon">🗑️</div>

                <h3>Delete Note?</h3>

                <p>
                    Are you sure you want to delete this note?
                    This action cannot be undone.
                </p>

                <div class="notes-modal-actions">

                    <button class="notes-secondary"
                            @onclick="CancelDelete">
                        Cancel
                    </button>

                    <button class="notes-danger"
                            @onclick="ConfirmDelete">
                        Yes, Delete
                    </button>

                </div>
            </div>

        </div>
    }

</div>

<style>
    .notes-page {
        padding: 15px 10px 40px;
        max-width: 1500px;
        margin: auto;
        color: #1e2440;
    }

    .notes-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 15px;
        flex-wrap: wrap;
        margin-bottom: 30px;
    }

        .notes-header h2 {
            font-size: 30px;
            font-weight: 800;
            margin-bottom: 8px;
        }

        .notes-header p,
        .notes-toolbar p {
            color: #8990a5;
            margin: 0;
        }

    .notes-primary {
        background: linear-gradient(120deg, #6658f5, #9360f7);
        color: white;
        border: none;
        padding: 12px 22px;
        border-radius: 12px;
        font-weight: 700;
        cursor: pointer;
    }

    .notes-secondary {
        background: #f0eaff;
        color: #6658f5;
        border: none;
        padding: 12px 22px;
        border-radius: 12px;
        font-weight: 700;
        cursor: pointer;
    }

    .notes-stats {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 20px;
        margin-bottom: 30px;
    }

    .notes-stat {
        background: white;
        border-radius: 18px;
        padding: 24px;
        display: flex;
        align-items: center;
        gap: 18px;
        box-shadow: 0 5px 25px rgba(30, 36, 64, 0.05);
    }

        .notes-stat > span {
            background: #f0eaff;
            width: 55px;
            height: 55px;
            border-radius: 15px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 27px;
        }

        .notes-stat small {
            color: #8990a5;
        }

        .notes-stat h3 {
            font-size: 28px;
            font-weight: 800;
            margin: 5px 0 0;
        }

    .notes-form-card {
        background: white;
        padding: 28px;
        border-radius: 22px;
        margin-bottom: 30px;
        box-shadow: 0 5px 25px rgba(30, 36, 64, 0.05);
    }

    .notes-form-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 25px;
    }

        .notes-form-header h3 {
            font-weight: 800;
            font-size: 22px;
        }

    .notes-close {
        border: none;
        background: #f0eaff;
        color: #6658f5;
        border-radius: 10px;
        padding: 10px 15px;
    }

    .notes-field {
        margin-bottom: 20px;
    }

        .notes-field label {
            display: block;
            font-size: 13px;
            font-weight: 700;
            margin-bottom: 8px;
        }

        .notes-field .form-control {
            padding: 12px;
            border-radius: 10px;
            border: 1px solid #e6e5f0;
        }

    .notes-form-actions {
        display: flex;
        gap: 12px;
        margin-top: 25px;
    }

    .notes-toolbar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        flex-wrap: wrap;
        margin-bottom: 25px;
    }

        .notes-toolbar h3 {
            font-size: 23px;
            font-weight: 800;
        }

    .notes-search {
        background: white;
        border: 1px solid #e6e5f0;
        border-radius: 12px;
        padding: 13px 18px;
        min-width: 270px;
        outline: none;
    }

    .notes-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 22px;
    }

    .note-card {
        background: white;
        border-radius: 22px;
        padding: 25px;
        box-shadow: 0 5px 25px rgba(30, 36, 64, 0.05);
        transition: 0.2s;
        min-width: 0;
    }

        .note-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 10px 30px rgba(102, 88, 245, 0.1);
        }

    .note-card-top {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 20px;
    }

    .note-icon {
        font-size: 30px;
        background: #f0eaff;
        padding: 12px;
        border-radius: 14px;
    }

    .note-subject {
        background: #f0eaff;
        color: #6658f5;
        padding: 7px 12px;
        border-radius: 20px;
        font-size: 11px;
        font-weight: 700;
    }

    .note-card h4 {
        font-size: 19px;
        font-weight: 800;
        margin-bottom: 15px;
        overflow-wrap: anywhere;
    }

    .note-preview {
        color: #8990a5;
        font-size: 13px;
        line-height: 1.7;
        min-height: 80px;
        overflow-wrap: anywhere;
    }

    .note-date {
        color: #969bad;
        font-size: 11px;
        margin-bottom: 20px;
    }

    .note-actions {
        display: flex;
        gap: 10px;
        border-top: 1px solid #f1eff8;
        padding-top: 18px;
    }

    .note-edit,
    .note-delete {
        flex: 1;
        border: none;
        border-radius: 10px;
        padding: 11px;
        font-size: 12px;
        font-weight: 700;
        cursor: pointer;
    }

    .note-edit {
        background: #f0eaff;
        color: #6658f5;
    }

    .note-delete {
        background: #fee2e2;
        color: #dc2626;
    }

    .notes-empty {
        background: white;
        text-align: center;
        padding: 60px;
        border-radius: 22px;
    }

        .notes-empty div {
            font-size: 45px;
        }

        .notes-empty h4 {
            font-weight: 800;
        }

        .notes-empty p {
            color: #969bad;
        }

    .notes-modal-overlay {
        position: fixed;
        inset: 0;
        background: rgba(20, 20, 40, 0.45);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 9999;
    }

    .notes-modal {
        background: white;
        padding: 35px;
        border-radius: 22px;
        width: 90%;
        max-width: 430px;
        text-align: center;
    }

    .notes-modal-icon {
        font-size: 45px;
    }

    .notes-modal h3 {
        font-weight: 800;
    }

    .notes-modal p {
        color: #8990a5;
    }

    .notes-modal-actions {
        display: flex;
        justify-content: center;
        gap: 12px;
        margin-top: 25px;
    }

    .notes-danger {
        background: #ef4444;
        color: white;
        border: none;
        padding: 12px 22px;
        border-radius: 12px;
        font-weight: 700;
    }

    @@media (max-width: 1100px) {
        .notes-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @@media (max-width: 700px) {
        .notes-grid,
        .notes-stats {
            grid-template-columns: 1fr;
        }
    }
</style>

@code {
    private List<StudyNote> notes = new();

    private StudyNote noteForm = new();

    private bool showForm;
    private bool isEditing;

    private int? noteToDelete;

    private string searchText = "";

    private int SubjectCount =>
        notes
            .Where(n => !string.IsNullOrWhiteSpace(n.Subject))
            .Select(n => n.Subject.Trim())
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .Count();

    private int RecentlyUpdatedCount =>
        notes.Count(n => n.UpdatedAt >= DateTime.Now.AddDays(-7));

    private IEnumerable<StudyNote> FilteredNotes =>
        notes.Where(n =>
            string.IsNullOrWhiteSpace(searchText) ||
            n.Title.Contains(searchText, StringComparison.OrdinalIgnoreCase) ||
            n.Content.Contains(searchText, StringComparison.OrdinalIgnoreCase) ||
            n.Subject.Contains(searchText, StringComparison.OrdinalIgnoreCase)
        );

    protected override void OnInitialized()
    {
        LoadNotes();
    }

    private void LoadNotes()
    {
        notes = NoteService.GetAll();
    }

    private void ShowAddForm()
    {
        noteForm = new StudyNote();
        isEditing = false;
        showForm = true;
    }

    private void EditNote(StudyNote note)
    {
        noteForm = new StudyNote
        {
            Id = note.Id,
            Title = note.Title,
            Content = note.Content,
            Subject = note.Subject,
            CreatedAt = note.CreatedAt,
            UpdatedAt = note.UpdatedAt
        };

        isEditing = true;
        showForm = true;
    }

    private void SaveNote()
    {
        if (isEditing)
            NoteService.Update(noteForm);
        else
            NoteService.Add(noteForm);

        LoadNotes();
        CancelEdit();
    }

    private void CancelEdit()
    {
        noteForm = new StudyNote();
        isEditing = false;
        showForm = false;
    }

    private void RequestDelete(int id)
    {
        noteToDelete = id;
    }

    private void CancelDelete()
    {
        noteToDelete = null;
    }

    private void ConfirmDelete()
    {
        if (noteToDelete.HasValue)
        {
            NoteService.Delete(noteToDelete.Value);
            LoadNotes();
        }

        noteToDelete = null;
    }

    private string GetPreview(string content)
    {
        if (string.IsNullOrWhiteSpace(content))
            return "";

        return content.Length > 160
            ? content[..160] + "..."
            : content;
    }
}