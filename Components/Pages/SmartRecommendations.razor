@page "/recommendations"
@rendermode InteractiveServer

@using StudyMate.Models
@using StudyMate.Services
@using StudyMate.Components.Shared

@inject RecommendationService RecommendationService

<PageTitle>Smart Recommendations - StudyMate</PageTitle>

<div class="recommendations-page">

    <div class="recommendations-header">
        <div>
            <h2>🧠 Smart Study Recommendations</h2>
            <p>Discover what to study next based on your deadlines, priorities, and progress.</p>
        </div>

        <button class="recommendations-refresh" @onclick="LoadRecommendations">
            ↻ Refresh
        </button>
    </div>

    <div class="recommendations-hero">
        <div>
            <div class="recommendations-label">
                ✨ YOUR PERSONAL STUDY ASSISTANT
            </div>

            <h3>Study smarter, not harder.</h3>

            <p>
                StudyMate analyzes your assignments and helps you
                focus on what matters most.
            </p>
        </div>

        <div class="recommendations-hero-icon">🧠</div>
    </div>

    <div class="recommendations-stats">

        <div class="recommendations-stat-item">
            <StatCard Icon="📚"
                      Value="@recommendations.Count.ToString()"
                      Title="Active Tasks"
                      Description="Tasks waiting to be completed" />
        </div>

        <div class="recommendations-stat-item">
            <StatCard Icon="🚨"
                      Value="@recommendations.Count(r => r.UrgencyLevel == "Overdue").ToString()"
                      Title="Overdue Tasks"
                      Description="Tasks requiring immediate attention" />
        </div>

        <div class="recommendations-stat-item">
            <StatCard Icon="🔥"
                      Value="@recommendations.Count(r => r.Priority == StudyTaskPriority.High).ToString()"
                      Title="High Priority"
                      Description="Your most important assignments" />
        </div>

    </div>

    <div class="recommendations-section-heading">
        <h3>🎯 Your Recommended Study Plan</h3>
        <p>Tasks are ranked by importance and deadline urgency.</p>
    </div>

    @if (recommendations.Count == 0)
    {
        <div class="recommendations-empty">
            <div>🎉</div>
            <h3>You're all caught up!</h3>
            <p>No pending assignments. Enjoy your free time!</p>
            <a href="/tasks">+ Add New Task</a>
        </div>
    }
    else
    {
        <div class="recommendations-list">

            @for (int i = 0; i < recommendations.Count; i++)
            {
                var recommendation = recommendations[i];

                <div class="recommendation-card">

                    <div class="recommendation-top">
                        <div class="recommendation-task-info">
                            <div class="recommendation-rank">
                                #@(i + 1)
                            </div>

                            <div>
                                <h4>@recommendation.Title</h4>
                                <span>
                                    📚 @(string.IsNullOrWhiteSpace(recommendation.Subject)
                                                                ? "General"
                                                                : recommendation.Subject)
                        </span>
                    </div>
                </div>

                        <div class="recommendation-score">
                            ⭐ @recommendation.Score pts
                        </div>
                    </div>

                    <div class="recommendation-badges">

                        <span class="recommendation-badge @GetUrgencyClass(recommendation)">
                            ⏰ @recommendation.UrgencyLevel
                        </span>

                        <span class="recommendation-badge priority">
                            🔥 @recommendation.Priority Priority
                        </span>

                        <span class="recommendation-badge status">
                            @recommendation.Status
                        </span>
                    </div>

                    <div class="recommendation-reason">
                        <strong>💡 Why this task?</strong>
                        <p>@recommendation.Reason</p>
                    </div>

                    <div class="recommendation-action">
                        <div>
                            <strong>🎯 Suggested Action</strong>
                            <p>@recommendation.SuggestedAction</p>
                        </div>

                        <a href="/tasks">View Task →</a>
                    </div>

                </div>
                }

        </div>
    }

</div>

<style>
    .recommendations-page {
        max-width: 1300px;
        margin: auto;
        padding: 15px 10px 50px;
        color: #1e2440;
    }

    .recommendations-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        margin-bottom: 25px;
    }

        .recommendations-header h2 {
            font-size: 29px;
            font-weight: 800;
            margin-bottom: 10px;
        }

        .recommendations-header p {
            color: #8990a5;
            font-size: 14px;
            margin: 0;
        }

    .recommendations-refresh {
        background: var(--theme-soft, #f0eaff);
        color: var(--theme-primary, #6658f5);
        border: none;
        border-radius: 12px;
        padding: 12px 20px;
        font-weight: 800;
        cursor: pointer;
    }

    .recommendations-hero {
        background: linear-gradient( 120deg, var(--theme-primary, #6658f5), var(--theme-secondary, #9360f7) );
        border-radius: 24px;
        padding: 35px;
        color: white;
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 25px;
    }

    .recommendations-label {
        font-size: 11px;
        font-weight: 800;
        letter-spacing: 2px;
        margin-bottom: 15px;
        opacity: 0.9;
    }

    .recommendations-hero h3 {
        font-size: 28px;
        font-weight: 800;
        color: white;
    }

    .recommendations-hero p {
        font-size: 14px;
        opacity: 0.9;
        max-width: 500px;
    }

    .recommendations-hero-icon {
        font-size: 85px;
    }

    .recommendations-stats {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 20px;
        margin-bottom: 35px;
    }

    .recommendations-section-heading {
        margin-bottom: 22px;
    }

        .recommendations-section-heading h3 {
            font-size: 22px;
            font-weight: 800;
        }

        .recommendations-section-heading p {
            color: #969bad;
            font-size: 13px;
        }

    .recommendations-list {
        display: flex;
        flex-direction: column;
        gap: 20px;
    }

    .recommendation-card {
        background: white;
        border-radius: 20px;
        padding: 28px;
        box-shadow: 0 5px 20px rgba(30, 36, 64, 0.05);
    }

    .recommendation-top {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 15px;
    }

    .recommendation-task-info {
        display: flex;
        align-items: center;
        gap: 15px;
    }

        .recommendation-task-info h4 {
            font-size: 18px;
            font-weight: 800;
            margin-bottom: 7px;
        }

        .recommendation-task-info span {
            color: #969bad;
            font-size: 12px;
        }

    .recommendation-rank {
        background: var(--theme-soft, #f0eaff);
        color: var(--theme-primary, #6658f5);
        border-radius: 12px;
        padding: 12px;
        font-weight: 800;
    }

    .recommendation-score {
        background: #fff7db;
        color: #d97706;
        border-radius: 12px;
        padding: 10px 15px;
        font-weight: 800;
        white-space: nowrap;
    }

    .recommendation-badges {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        margin: 20px 0;
    }

    .recommendation-badge {
        padding: 8px 13px;
        border-radius: 9px;
        font-size: 12px;
        font-weight: 700;
        background: #f1f5f9;
        color: #475569;
    }

        .recommendation-badge.overdue {
            background: #fee2e2;
            color: #dc2626;
        }

        .recommendation-badge.today {
            background: #ffedd5;
            color: #ea580c;
        }

        .recommendation-badge.tomorrow {
            background: #fef3c7;
            color: #b45309;
        }

        .recommendation-badge.priority {
            background: #fce7f3;
            color: #be185d;
        }

        .recommendation-badge.status {
            background: #e0f2fe;
            color: #0369a1;
        }

    .recommendation-reason {
        background: #f8f7ff;
        padding: 17px;
        border-radius: 12px;
        margin-bottom: 15px;
    }

        .recommendation-reason strong {
            font-size: 13px;
        }

        .recommendation-reason p {
            color: #777d96;
            font-size: 13px;
            margin: 8px 0 0;
        }

    .recommendation-action {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        background: var(--theme-soft, #f0eaff);
        padding: 18px;
        border-radius: 12px;
    }

        .recommendation-action strong {
            font-size: 13px;
        }

        .recommendation-action p {
            font-size: 13px;
            color: #777d96;
            margin: 8px 0 0;
        }

        .recommendation-action a {
            background: var(--theme-primary, #6658f5);
            color: white;
            padding: 11px 16px;
            border-radius: 10px;
            text-decoration: none;
            font-size: 12px;
            font-weight: 800;
            white-space: nowrap;
        }

    .recommendations-empty {
        background: white;
        padding: 55px;
        border-radius: 22px;
        text-align: center;
    }

        .recommendations-empty > div {
            font-size: 50px;
            margin-bottom: 15px;
        }

        .recommendations-empty h3 {
            font-weight: 800;
        }

        .recommendations-empty p {
            color: #969bad;
        }

        .recommendations-empty a {
            display: inline-block;
            background: var(--theme-primary, #6658f5);
            color: white;
            padding: 12px 20px;
            border-radius: 12px;
            text-decoration: none;
            font-weight: 700;
        }

    @@media (max-width: 700px) {
        /* PAGE */

        .recommendations-page {
            width: 100%;
            max-width: 100%;
            min-width: 0;
            padding: 12px 0 25px;
            box-sizing: border-box;
        }

            .recommendations-page * {
                box-sizing: border-box;
            }
        /* HEADER */

        .recommendations-header {
            display: flex;
            flex-direction: column;
            align-items: flex-start;
            gap: 12px;
            margin-bottom: 18px;
        }

            .recommendations-header h2 {
                font-size: 23px;
                line-height: 1.3;
                margin-bottom: 7px;
            }

            .recommendations-header p {
                font-size: 12px;
                line-height: 1.5;
            }

        .recommendations-refresh {
            padding: 10px 15px;
            font-size: 12px;
            border-radius: 10px;
        }
        /* HERO */

        .recommendations-hero {
            padding: 20px 16px;
            border-radius: 16px;
            margin-bottom: 18px;
            min-width: 0;
        }

        .recommendations-hero-icon {
            display: none;
        }

        .recommendations-label {
            font-size: 9px;
            letter-spacing: 1px;
            line-height: 1.5;
            margin-bottom: 10px;
        }

        .recommendations-hero h3 {
            font-size: 21px;
            line-height: 1.3;
            margin-bottom: 9px;
        }

        .recommendations-hero p {
            font-size: 12px;
            line-height: 1.5;
            margin-bottom: 0;
        }
        /* STATISTICS */

        .recommendations-stats {
            display: grid !important;
            grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
            gap: 10px !important;
            margin-bottom: 25px;
            width: 100%;
        }

            .recommendations-stats > .shared-stat-card {
                grid-column: auto !important;
                width: 100% !important;
                min-width: 0;
                max-width: 100%;
            }

                .recommendations-stats > .shared-stat-card:nth-child(3) {
                    grid-column: 1 / -1 !important;
                }
            /* REUSABLE STAT CARDS */

            .recommendations-stats .shared-stat-card {
                padding: 12px 9px;
                min-height: 115px;
                border-radius: 13px;
            }

            .recommendations-stats .shared-stat-icon {
                font-size: 23px;
                margin-bottom: 5px;
            }

            .recommendations-stats .shared-stat-card h3 {
                font-size: 23px;
                margin: 4px 0;
            }

            .recommendations-stats .shared-stat-card p {
                font-size: 11px;
                line-height: 1.3;
            }

            .recommendations-stats .shared-stat-card small {
                font-size: 9px;
                line-height: 1.4;
            }
        /* SECTION HEADING */

        .recommendations-section-heading {
            margin-bottom: 15px;
        }

            .recommendations-section-heading h3 {
                font-size: 18px;
                line-height: 1.4;
                margin-bottom: 6px;
            }

            .recommendations-section-heading p {
                font-size: 11px;
                line-height: 1.5;
                margin-bottom: 0;
            }
        /* RECOMMENDATION LIST */

        .recommendations-list {
            gap: 12px;
        }

        .recommendation-card {
            width: 100%;
            min-width: 0;
            padding: 15px;
            border-radius: 15px;
        }
        /* TASK TITLE AND SCORE */

        .recommendation-top {
            display: flex;
            flex-direction: column;
            align-items: flex-start;
            gap: 10px;
        }

        .recommendation-task-info {
            display: flex;
            align-items: flex-start;
            gap: 10px;
            width: 100%;
            min-width: 0;
        }

            .recommendation-task-info > div:last-child {
                min-width: 0;
                flex: 1;
            }

            .recommendation-task-info h4 {
                font-size: 14px;
                line-height: 1.4;
                margin-bottom: 5px;
                overflow-wrap: anywhere;
            }

            .recommendation-task-info span {
                font-size: 11px;
                line-height: 1.4;
                overflow-wrap: anywhere;
            }

        .recommendation-rank {
            padding: 9px;
            border-radius: 9px;
            font-size: 12px;
            flex-shrink: 0;
        }

        .recommendation-score {
            padding: 7px 10px;
            border-radius: 9px;
            font-size: 11px;
        }
        /* BADGES */

        .recommendation-badges {
            display: flex;
            flex-wrap: wrap;
            gap: 6px;
            margin: 13px 0;
        }

        .recommendation-badge {
            padding: 6px 9px;
            border-radius: 8px;
            font-size: 10px;
            line-height: 1.3;
            white-space: normal;
        }
        /* WHY THIS TASK */

        .recommendation-reason {
            padding: 12px;
            border-radius: 10px;
            margin-bottom: 10px;
        }

            .recommendation-reason strong {
                font-size: 11px;
            }

            .recommendation-reason p {
                font-size: 11px;
                line-height: 1.5;
                margin-top: 6px;
                overflow-wrap: anywhere;
            }
        /* SUGGESTED ACTION */

        .recommendation-action {
            display: flex;
            flex-direction: column;
            align-items: flex-start;
            gap: 12px;
            padding: 12px;
            border-radius: 10px;
        }

            .recommendation-action > div {
                min-width: 0;
                width: 100%;
            }

            .recommendation-action strong {
                font-size: 11px;
            }

            .recommendation-action p {
                font-size: 11px;
                line-height: 1.5;
                margin-top: 6px;
                overflow-wrap: anywhere;
            }

            .recommendation-action a {
                display: inline-block;
                padding: 9px 13px;
                border-radius: 9px;
                font-size: 11px;
                white-space: nowrap;
            }
        /* EMPTY STATE */

        .recommendations-empty {
            padding: 30px 15px;
            border-radius: 15px;
        }

            .recommendations-empty > div {
                font-size: 35px;
                margin-bottom: 10px;
            }

            .recommendations-empty h3 {
                font-size: 18px;
            }

            .recommendations-empty p {
                font-size: 12px;
                line-height: 1.5;
            }

            .recommendations-empty a {
                padding: 10px 15px;
                font-size: 11px;
                border-radius: 9px;
            }
        /* FIX RECOMMENDATIONS STATISTICS */

        .recommendations-stat-item {
            min-width: 0;
            width: 100%;
        }

        @@media (max-width: 700px) {

            .recommendations-stats {
                display: grid !important;
                grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
                gap: 10px !important;
            }

                .recommendations-stats > .recommendations-stat-item {
                    grid-column: auto !important;
                    grid-row: auto !important;
                    min-width: 0;
                    width: 100%;
                }

                    .recommendations-stats > .recommendations-stat-item:nth-child(3) {
                        grid-column: 1 / -1 !important;
                    }

            .recommendations-stat-item .shared-stat-card {
                width: 100%;
                height: 100%;
                min-width: 0;
            }
        }
    }

</style>

@code {
    private List<SmartRecommendation> recommendations = new();

    protected override void OnInitialized()
    {
        LoadRecommendations();
    }

    private void LoadRecommendations()
    {
        recommendations = RecommendationService.GetRecommendations();
    }

    private string GetUrgencyClass(SmartRecommendation recommendation)
    {
        return recommendation.UrgencyLevel switch
        {
            "Overdue" => "overdue",
            "Due Today" => "today",
            "Due Tomorrow" => "tomorrow",
            _ => ""
        };
    }
}