@page "/recommendations"
@rendermode InteractiveServer

@using StudyMate.Models
@using StudyMate.Services
@using StudyMate.Components.Shared

@inject RecommendationService RecommendationService

<PageTitle>Smart Recommendations - StudyMate</PageTitle>

<div class="recommendations-page">

    <div class="recommendations-header">
        <div>
            <h2>🧠 Smart Study Recommendations</h2>
            <p>Discover what to study next based on your deadlines, priorities, and progress.</p>
        </div>

        <button class="recommendations-refresh" @onclick="LoadRecommendations">
            ↻ Refresh
        </button>
    </div>

    <div class="recommendations-hero">
        <div>
            <div class="recommendations-label">
                ✨ YOUR PERSONAL STUDY ASSISTANT
            </div>

            <h3>Study smarter, not harder.</h3>

            <p>
                StudyMate analyzes your assignments and helps you
                focus on what matters most.
            </p>
        </div>

        <div class="recommendations-hero-icon">🧠</div>
    </div>

    <div class="recommendations-stats">

        <StatCard Icon="📚"
                  Value="@recommendations.Count.ToString()"
                  Title="Active Tasks"
                  Description="Tasks waiting to be completed" />

        <StatCard Icon="🚨"
                  Value="@recommendations.Count(r => r.UrgencyLevel == "Overdue").ToString()"
                  Title="Overdue Tasks"
                  Description="Tasks requiring immediate attention" />

        <StatCard Icon="🔥"
                  Value="@recommendations.Count(r => r.Priority == StudyTaskPriority.High).ToString()"
                  Title="High Priority"
                  Description="Your most important assignments" />

    </div>

    <div class="recommendations-section-heading">
        <h3>🎯 Your Recommended Study Plan</h3>
        <p>Tasks are ranked by importance and deadline urgency.</p>
    </div>

    @if (recommendations.Count == 0)
    {
        <div class="recommendations-empty">
            <div>🎉</div>
            <h3>You're all caught up!</h3>
            <p>No pending assignments. Enjoy your free time!</p>
            <a href="/tasks">+ Add New Task</a>
        </div>
    }
    else
    {
        <div class="recommendations-list">

            @for (int i = 0; i < recommendations.Count; i++)
            {
                var recommendation = recommendations[i];

                <div class="recommendation-card">

                    <div class="recommendation-top">
                        <div class="recommendation-task-info">
                            <div class="recommendation-rank">
                                #@(i + 1)
                            </div>

                            <div>
                                <h4>@recommendation.Title</h4>
                                <span>
                                    📚 @(string.IsNullOrWhiteSpace(recommendation.Subject)
                                                                ? "General"
                                                                : recommendation.Subject)
                        </span>
                    </div>
                </div>

                        <div class="recommendation-score">
                            ⭐ @recommendation.Score pts
                        </div>
                    </div>

                    <div class="recommendation-badges">

                        <span class="recommendation-badge @GetUrgencyClass(recommendation)">
                            ⏰ @recommendation.UrgencyLevel
                        </span>

                        <span class="recommendation-badge priority">
                            🔥 @recommendation.Priority Priority
                        </span>

                        <span class="recommendation-badge status">
                            @recommendation.Status
                        </span>
                    </div>

                    <div class="recommendation-reason">
                        <strong>💡 Why this task?</strong>
                        <p>@recommendation.Reason</p>
                    </div>

                    <div class="recommendation-action">
                        <div>
                            <strong>🎯 Suggested Action</strong>
                            <p>@recommendation.SuggestedAction</p>
                        </div>

                        <a href="/tasks">View Task →</a>
                    </div>

                </div>
                }

        </div>
    }

</div>

<style>
    .recommendations-page {
        max-width: 1300px;
        margin: auto;
        padding: 15px 10px 50px;
        color: #1e2440;
    }

    .recommendations-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        margin-bottom: 25px;
    }

        .recommendations-header h2 {
            font-size: 29px;
            font-weight: 800;
            margin-bottom: 10px;
        }

        .recommendations-header p {
            color: #8990a5;
            font-size: 14px;
            margin: 0;
        }

    .recommendations-refresh {
        background: var(--theme-soft, #f0eaff);
        color: var(--theme-primary, #6658f5);
        border: none;
        border-radius: 12px;
        padding: 12px 20px;
        font-weight: 800;
        cursor: pointer;
    }

    .recommendations-hero {
        background: linear-gradient( 120deg, var(--theme-primary, #6658f5), var(--theme-secondary, #9360f7) );
        border-radius: 24px;
        padding: 35px;
        color: white;
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 25px;
    }

    .recommendations-label {
        font-size: 11px;
        font-weight: 800;
        letter-spacing: 2px;
        margin-bottom: 15px;
        opacity: 0.9;
    }

    .recommendations-hero h3 {
        font-size: 28px;
        font-weight: 800;
        color: white;
    }

    .recommendations-hero p {
        font-size: 14px;
        opacity: 0.9;
        max-width: 500px;
    }

    .recommendations-hero-icon {
        font-size: 85px;
    }

    .recommendations-stats {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 20px;
        margin-bottom: 35px;
    }

    .recommendations-section-heading {
        margin-bottom: 22px;
    }

        .recommendations-section-heading h3 {
            font-size: 22px;
            font-weight: 800;
        }

        .recommendations-section-heading p {
            color: #969bad;
            font-size: 13px;
        }

    .recommendations-list {
        display: flex;
        flex-direction: column;
        gap: 20px;
    }

    .recommendation-card {
        background: white;
        border-radius: 20px;
        padding: 28px;
        box-shadow: 0 5px 20px rgba(30, 36, 64, 0.05);
    }

    .recommendation-top {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 15px;
    }

    .recommendation-task-info {
        display: flex;
        align-items: center;
        gap: 15px;
    }

        .recommendation-task-info h4 {
            font-size: 18px;
            font-weight: 800;
            margin-bottom: 7px;
        }

        .recommendation-task-info span {
            color: #969bad;
            font-size: 12px;
        }

    .recommendation-rank {
        background: var(--theme-soft, #f0eaff);
        color: var(--theme-primary, #6658f5);
        border-radius: 12px;
        padding: 12px;
        font-weight: 800;
    }

    .recommendation-score {
        background: #fff7db;
        color: #d97706;
        border-radius: 12px;
        padding: 10px 15px;
        font-weight: 800;
        white-space: nowrap;
    }

    .recommendation-badges {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        margin: 20px 0;
    }

    .recommendation-badge {
        padding: 8px 13px;
        border-radius: 9px;
        font-size: 12px;
        font-weight: 700;
        background: #f1f5f9;
        color: #475569;
    }

        .recommendation-badge.overdue {
            background: #fee2e2;
            color: #dc2626;
        }

        .recommendation-badge.today {
            background: #ffedd5;
            color: #ea580c;
        }

        .recommendation-badge.tomorrow {
            background: #fef3c7;
            color: #b45309;
        }

        .recommendation-badge.priority {
            background: #fce7f3;
            color: #be185d;
        }

        .recommendation-badge.status {
            background: #e0f2fe;
            color: #0369a1;
        }

    .recommendation-reason {
        background: #f8f7ff;
        padding: 17px;
        border-radius: 12px;
        margin-bottom: 15px;
    }

        .recommendation-reason strong {
            font-size: 13px;
        }

        .recommendation-reason p {
            color: #777d96;
            font-size: 13px;
            margin: 8px 0 0;
        }

    .recommendation-action {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        background: var(--theme-soft, #f0eaff);
        padding: 18px;
        border-radius: 12px;
    }

        .recommendation-action strong {
            font-size: 13px;
        }

        .recommendation-action p {
            font-size: 13px;
            color: #777d96;
            margin: 8px 0 0;
        }

        .recommendation-action a {
            background: var(--theme-primary, #6658f5);
            color: white;
            padding: 11px 16px;
            border-radius: 10px;
            text-decoration: none;
            font-size: 12px;
            font-weight: 800;
            white-space: nowrap;
        }

    .recommendations-empty {
        background: white;
        padding: 55px;
        border-radius: 22px;
        text-align: center;
    }

        .recommendations-empty > div {
            font-size: 50px;
            margin-bottom: 15px;
        }

        .recommendations-empty h3 {
            font-weight: 800;
        }

        .recommendations-empty p {
            color: #969bad;
        }

        .recommendations-empty a {
            display: inline-block;
            background: var(--theme-primary, #6658f5);
            color: white;
            padding: 12px 20px;
            border-radius: 12px;
            text-decoration: none;
            font-weight: 700;
        }

    @@media (max-width: 700px) {
        .recommendations-stats {
            grid-template-columns: 1fr;
        }

        .recommendations-hero-icon {
            display: none;
        }

        .recommendation-top,
        .recommendation-action {
            flex-direction: column;
            align-items: flex-start;
        }

        .recommendation-card {
            padding: 20px;
        }
    }
</style>

@code {
    private List<SmartRecommendation> recommendations = new();

    protected override void OnInitialized()
    {
        LoadRecommendations();
    }

    private void LoadRecommendations()
    {
        recommendations = RecommendationService.GetRecommendations();
    }

    private string GetUrgencyClass(SmartRecommendation recommendation)
    {
        return recommendation.UrgencyLevel switch
        {
            "Overdue" => "overdue",
            "Due Today" => "today",
            "Due Tomorrow" => "tomorrow",
            _ => ""
        };
    }
}