    }

    .tasks-stat-card h3 {
        font-size: 28px;
        font-weight: 800;
        margin: 5px 0 0;
    }

    .tasks-form-card,
    .tasks-list-card {
        background: white;
        padding: 28px;
        border-radius: 22px;
        box-shadow: 0 5px 25px rgba(30, 36, 64, 0.05);
        margin-bottom: 25px;
    }

    .tasks-section-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 24px;
    }

        .tasks-section-header h3 {
            font-size: 22px;
            font-weight: 800;
            margin-bottom: 5px;
        }

        .tasks-section-header p {
            color: #969bad;
            font-size: 13px;
            margin: 0;
        }

    .tasks-close-button {
