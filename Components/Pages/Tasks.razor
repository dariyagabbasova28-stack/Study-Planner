@page "/tasks"
@rendermode InteractiveServer

@using StudyMate.Models
@using StudyMate.Services
@using System.Globalization

@inject TaskService TaskService
@inject ValidationService ValidationService

<PageTitle>My Tasks - StudyMate</PageTitle>

<div class="tasks-page">

    @if (!string.IsNullOrWhiteSpace(operationError))
    {
        <div class="tasks-error" role="alert">
            ⚠️ @operationError
        </div>
    }

    <!-- PAGE HEADER -->

    <div class="tasks-header">
        <div>
            <h2>📝 My Tasks</h2>
            <p>Manage your assignments and stay on top of deadlines.</p>
        </div>

        <button class="tasks-primary-button"
                @onclick="ShowAddForm">
            + Add New Task
        </button>
    </div>

    <!-- STATISTICS -->

    <div class="tasks-stats">

        <div class="tasks-stat-card">
            <span class="tasks-stat-icon">📋</span>
            <div>
                <small>Total Tasks</small>
                <h3>@tasks.Count</h3>
            </div>
        </div>

        <div class="tasks-stat-card">
            <span class="tasks-stat-icon">⏳</span>
            <div>
                <small>Pending</small>
                <h3>
                    @tasks.Count(t => t.Status == StudyTaskStatus.Pending)
                </h3>
            </div>
        </div>

        <div class="tasks-stat-card">
            <span class="tasks-stat-icon">🚀</span>
            <div>
                <small>In Progress</small>
                <h3>
                    @tasks.Count(t => t.Status == StudyTaskStatus.InProgress)
                </h3>
            </div>
        </div>

        <div class="tasks-stat-card">
            <span class="tasks-stat-icon">✅</span>
            <div>
                <small>Completed</small>
                <h3>
                    @tasks.Count(t => t.Status == StudyTaskStatus.Completed)
                </h3>
            </div>
        </div>

    </div>

    <!-- ADD / EDIT FORM -->
    @if (showForm)
    {
        <div class="tasks-form-card">

            <div class="tasks-section-header">
                <h3>
                    @(isEditing ? "✏️ Edit Task" : "✨ Add New Task")
                </h3>

                <button type="button"
                        class="tasks-close-button"
                        @onclick="CancelEdit">
                    ✕
                </button>
            </div>

            <EditForm Model="taskForm"
                      OnSubmit="SaveTask"
                      FormName="taskForm">

                <DataAnnotationsValidator />
                <ValidationSummary />

                @if (!string.IsNullOrWhiteSpace(validationError))
                {
                    <div class="tasks-error" role="alert">
                        ⚠️ @validationError
                    </div>
                }

                <div class="tasks-form-grid">

                    <div class="tasks-field">
                        <label>Task Title</label>

                        <InputText class="form-control"
                                   @bind-Value="taskForm.Title"
                                   placeholder="Enter task title" />
                    </div>

                    <div class="tasks-field">
                        <label>Subject</label>

                        <InputText class="form-control"
                                   @bind-Value="taskForm.Subject"
                                   placeholder="e.g. Mathematics" />
                    </div>

                    <div class="tasks-field full-width">
                        <label>Description</label>

                        <InputTextArea class="form-control"
                                       @bind-Value="taskForm.Description"
                                       placeholder="Describe your assignment..."
                                       rows="3" />
                    </div>

                    <div class="tasks-field">
                        <label>Due Date</label>

                        <InputDate class="form-control"
                                   @bind-Value="taskForm.DueDate" />
                    </div>

                    <div class="tasks-field">
                        <label>Priority</label>

                        <InputSelect class="form-select"
                                     @bind-Value="taskForm.Priority">

                            @foreach (var priority in Enum.GetValues<StudyTaskPriority>())
                            {
                                <option value="@priority">
                                    @priority
                                </option>
                            }

                        </InputSelect>
                    </div>

                    <div class="tasks-field">
                        <label>Status</label>

                        <InputSelect class="form-select"
                                     @bind-Value="taskForm.Status">

                            @foreach (var status in Enum.GetValues<StudyTaskStatus>())
                            {
                                <option value="@status">
                                    @status
                                </option>
                            }

                        </InputSelect>
                    </div>

                </div>

                <div class="tasks-form-actions">

                    <button type="submit"
                            class="tasks-primary-button">
                        @(isEditing ? "Save Changes" : "Create Task")
                    </button>

                    <button type="button"
                            class="tasks-secondary-button"
                            @onclick="CancelEdit">
                        Cancel
                    </button>

                </div>

            </EditForm>

        </div>
    }

    <!-- TASK LIST -->

    <div class="tasks-list-card">

        <div class="tasks-section-header">
            <div>
                <h3>All Assignments</h3>
                <p>@FilteredTasks.Count() tasks found</p>
            </div>
        </div>

        <!-- FILTERS -->

        <div class="tasks-filters">

            <input class="form-control"
                   placeholder="🔍 Search tasks..."
                   @bind="searchText"
                   @bind:event="oninput" />

            <select class="form-select"
                    @bind="statusFilter">

                <option value="All">All Statuses</option>
                <option value="Pending">Pending</option>
                <option value="InProgress">In Progress</option>
                <option value="Completed">Completed</option>

            </select>

            <select class="form-select"
                    @bind="priorityFilter">

                <option value="All">All Priorities</option>
                <option value="Low">Low</option>
                <option value="Medium">Medium</option>
                <option value="High">High</option>

            </select>

            <select class="form-select"
                    @bind="sortOrder">

                <option value="DueSoon">Due Date: Earliest</option>
                <option value="DueLate">Due Date: Latest</option>
                <option value="Priority">Priority: Highest</option>
                <option value="Title">Title: A-Z</option>

            </select>

        </div>

        @if (!FilteredTasks.Any())
        {
            <div class="tasks-empty">
                <div>📭</div>
                <h4>No tasks found</h4>
                <p>Add a new task or change your filters.</p>
            </div>
        }
        else
        {
            <div class="tasks-table-wrapper">

                <table class="tasks-table">

                    <thead>
                        <tr>
                            <th>Assignment</th>
                            <th>Subject</th>
                            <th>Due Date</th>
                            <th>Priority</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var task in FilteredTasks)
                        {
                            var isOverdue =
                            task.DueDate.Date < DateTime.Today &&
                            task.Status != StudyTaskStatus.Completed;

                            <tr>

                                <td data-label="Assignment">

                                    <div class="tasks-title-cell">

                                        <strong>@task.Title</strong>

                                        @if (!string.IsNullOrWhiteSpace(task.Description))
                                        {
                                            <small>@task.Description</small>
                                        }

                                    </div>

                                </td>

                                <td data-label="Subject">
                                    @task.Subject
                                </td>

                                <td data-label="Due Date">

                                    <div class="tasks-date-cell">

                                        @task.DueDate.ToString(
                                        "dd MMM yyyy",
                                                                englishCulture)

                                @if (isOverdue)
                                        {
                                            <span class="tasks-overdue">
                                                Overdue
                                            </span>
                                        }

                                </div>

                            </td>

                            <td data-label="Priority">

                                <span class="tasks-priority priority-@task.Priority.ToString().ToLowerInvariant()">
                                    @task.Priority
                                </span>

                            </td>

                            <td data-label="Status">

                                <span class="tasks-status status-@task.Status.ToString().ToLowerInvariant()">
                                    @(task.Status == StudyTaskStatus.InProgress
                                                                    ? "In Progress"
                                                                    : task.Status.ToString())
                            </span>

                                </td>

                                <td data-label="Actions">

                                    <div class="tasks-actions">

                                        <button class="tasks-action edit"
                                                title="Edit"
                                                aria-label="Edit task"
                                                @onclick="() => EditTask(task)">
                                            ✏️
                                        </button>

                                @if (task.Status == StudyTaskStatus.Pending)
                                        {
                                            <button class="tasks-action progress-action"
                                                    title="Start Task"
                                                    aria-label="Start task"
                                                    @onclick="() => ChangeStatus(task, StudyTaskStatus.InProgress)">
                                                ▶️
                                            </button>
                                        }

                                        @if (task.Status != StudyTaskStatus.Completed)
                                        {
                                            <button class="tasks-action complete"
                                                    title="Complete Task"
                                                    aria-label="Complete task"
                                                    @onclick="() => CompleteTask(task.Id)">
                                                ✅
                                            </button>
                                        }

                                        <button class="tasks-action delete"
                                                title="Delete"
                                                aria-label="Delete task"
                                                @onclick="() => RequestDelete(task.Id)">
                                            🗑️
                                        </button>

                                    </div>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }

    </div>

    <!-- DELETE CONFIRMATION -->
    @if (taskToDelete.HasValue)
    {
        <div class="tasks-modal-overlay">

            <div class="tasks-modal">

                <div class="tasks-modal-icon">🗑️</div>

                <h3>Delete Task?</h3>

                <p>
                    Are you sure you want to delete this task?
                    This action cannot be undone.
                </p>

                <div class="tasks-modal-actions">

                    <button class="tasks-secondary-button"
                            @onclick="CancelDelete">
                        Cancel
                    </button>

                    <button class="tasks-danger-button"
                            @onclick="ConfirmDelete">
                        Yes, Delete
                    </button>

                </div>

            </div>

        </div>
    }

</div>

<style>

    /* GENERAL PAGE */

    .tasks-page {
        width: 100%;
        max-width: 1500px;
        min-width: 0;
        margin: 0 auto;
        padding: 15px 10px 40px;
        color: #1e2440;
        box-sizing: border-box;
    }

        .tasks-page * {
            box-sizing: border-box;
        }

    /* HEADER */

    .tasks-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        margin-bottom: 25px;
    }

        .tasks-header h2 {
            font-size: 30px;
            font-weight: 800;
            margin: 0 0 8px;
        }

        .tasks-header p {
            font-size: 14px;
            color: #8990a5;
            margin: 0;
        }

    /* BUTTONS */

    .tasks-primary-button {
        background: linear-gradient(120deg, #6658f5, #9360f7);
        color: white;
        border: none;
        padding: 12px 20px;
        border-radius: 12px;
        font-size: 13px;
        font-weight: 700;
        cursor: pointer;
        box-shadow: 0 5px 15px rgba(102, 88, 245, 0.18);
    }

        .tasks-primary-button:hover {
            opacity: 0.9;
        }

    .tasks-secondary-button {
        background: #f1efff;
        color: #6658f5;
        border: none;
        padding: 12px 20px;
        border-radius: 12px;
        font-weight: 700;
        cursor: pointer;
    }

    .tasks-danger-button {
        background: #ef4444;
        color: white;
        border: none;
        padding: 12px 20px;
        border-radius: 12px;
        font-weight: 700;
        cursor: pointer;
    }

    /* STATISTICS */

    .tasks-stats {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 16px;
        margin-bottom: 25px;
    }

    .tasks-stat-card {
        background: white;
        border-radius: 18px;
        padding: 22px;
        display: flex;
        align-items: center;
        gap: 15px;
        min-width: 0;
        box-shadow: 0 5px 25px rgba(30, 36, 64, 0.05);
    }

    .tasks-stat-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 52px;
        height: 52px;
        flex-shrink: 0;
        background: #f0eaff;
        border-radius: 13px;
        font-size: 25px;
    }

    .tasks-stat-card small {
        display: block;
        color: #8990a5;
        font-size: 12px;
    }

    .tasks-stat-card h3 {
        margin: 6px 0 0;
        font-size: 29px;
        font-weight: 800;
        color: #1e2440;
    }

    /* PANELS */

    .tasks-form-card,
    .tasks-list-card {
        background: white;
        padding: 25px;
        border-radius: 20px;
        margin-bottom: 24px;
        box-shadow: 0 5px 25px rgba(30, 36, 64, 0.05);
        min-width: 0;
    }

    .tasks-section-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        margin-bottom: 20px;
    }

        .tasks-section-header h3 {
            font-size: 20px;
            font-weight: 800;
            margin: 0;
        }

        .tasks-section-header p {
            color: #8990a5;
            font-size: 12px;
            margin: 5px 0 0;
        }

    .tasks-close-button {
        background: #f3f0ff;
        color: #6658f5;
        border: none;
        width: 35px;
        height: 35px;
        border-radius: 9px;
        cursor: pointer;
    }

    /* FORM */

    .tasks-form-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 17px;
    }

    .tasks-field {
        display: flex;
        flex-direction: column;
        gap: 7px;
        min-width: 0;
    }

        .tasks-field label {
            font-size: 12px;
            font-weight: 700;
        }

        .tasks-field .form-control,
        .tasks-field .form-select {
            width: 100%;
            min-width: 0;
            padding: 12px;
            border: 1px solid #e8e7f3;
            border-radius: 10px;
            background: #fafaff;
        }

            .tasks-field .form-control:focus,
            .tasks-field .form-select:focus {
                border-color: #9360f7;
                box-shadow: 0 0 0 3px rgba(147, 96, 247, 0.1);
            }

    .full-width {
        grid-column: 1 / -1;
    }

    .tasks-form-actions {
        display: flex;
        gap: 10px;
        margin-top: 20px;
    }

    /* FILTERS */

    .tasks-filters {
        display: grid;
        grid-template-columns: 2fr 1fr 1fr 1fr;
        gap: 12px;
        margin-bottom: 20px;
    }

        .tasks-filters .form-control,
        .tasks-filters .form-select {
            width: 100%;
            min-width: 0;
            padding: 11px;
            border: 1px solid #e8e7f3;
            border-radius: 10px;
            background: #fafaff;
            font-size: 12px;
        }

    /* TABLE */

    .tasks-table-wrapper {
        width: 100%;
        overflow-x: auto;
    }

    .tasks-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 13px;
    }

        .tasks-table th {
            background: #f6f4ff;
            color: #6658f5;
            text-align: left;
            padding: 15px 12px;
            font-size: 12px;
            font-weight: 800;
            white-space: nowrap;
        }

        .tasks-table td {
            padding: 16px 12px;
            border-bottom: 1px solid #f0eef7;
            vertical-align: middle;
        }

        .tasks-table tbody tr:hover {
            background: #faf9ff;
        }

    .tasks-title-cell {
        display: flex;
        flex-direction: column;
        gap: 5px;
        min-width: 0;
    }

        .tasks-title-cell strong {
            font-size: 13px;
            color: #1e2440;
            overflow-wrap: anywhere;
        }

        .tasks-title-cell small {
            font-size: 11px;
            color: #8990a5;
            overflow-wrap: anywhere;
        }

    .tasks-date-cell {
        display: flex;
        flex-direction: column;
        gap: 5px;
    }

    .tasks-overdue {
        color: #dc2626;
        font-size: 10px;
        font-weight: 700;
    }

    /* BADGES */

    .tasks-priority,
    .tasks-status {
        display: inline-block;
        padding: 7px 10px;
        border-radius: 9px;
        font-size: 11px;
        font-weight: 700;
        white-space: nowrap;
    }

        .tasks-priority.priority-high {
            background: #fee2e2;
            color: #dc2626;
        }

        .tasks-priority.priority-medium {
            background: #fef3c7;
            color: #d97706;
        }

        .tasks-priority.priority-low {
            background: #dcfce7;
            color: #15803d;
        }

        .tasks-status.status-pending {
            background: #f3f4f6;
            color: #6b7280;
        }

        .tasks-status.status-inprogress {
            background: #dbeafe;
            color: #2563eb;
        }

        .tasks-status.status-completed {
            background: #dcfce7;
            color: #15803d;
        }

    /* ACTIONS */

    .tasks-actions {
        display: flex;
        gap: 6px;
        flex-wrap: wrap;
    }

    .tasks-action {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 35px;
        height: 35px;
        border: none;
        border-radius: 9px;
        cursor: pointer;
        background: #f2efff;
        font-size: 14px;
    }

        .tasks-action:hover {
            transform: translateY(-1px);
        }

        .tasks-action.edit {
            background: #ede9fe;
        }

        .tasks-action.progress-action {
            background: #dbeafe;
        }

        .tasks-action.complete {
            background: #dcfce7;
        }

        .tasks-action.delete {
            background: #fee2e2;
        }

    /* EMPTY STATE */

    .tasks-empty {
        text-align: center;
        padding: 45px 15px;
    }

        .tasks-empty div {
            font-size: 45px;
        }

        .tasks-empty h4 {
            margin: 12px 0 6px;
            font-weight: 800;
        }

        .tasks-empty p {
            color: #8990a5;
            font-size: 13px;
        }

    /* ERRORS */

    .tasks-error {
        background: #fee2e2;
        color: #b91c1c;
        border: 1px solid #fecaca;
        padding: 12px 15px;
        border-radius: 10px;
        margin-bottom: 15px;
        font-size: 13px;
    }

    /* DELETE MODAL */

    .tasks-modal-overlay {
        position: fixed;
        inset: 0;
        z-index: 1000;
        background: rgba(20, 20, 40, 0.55);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 20px;
    }

    .tasks-modal {
        background: white;
        border-radius: 20px;
        padding: 30px;
        width: 100%;
        max-width: 420px;
        text-align: center;
        box-shadow: 0 20px 60px rgba(0, 0, 0, 0.15);
    }

    .tasks-modal-icon {
        font-size: 45px;
        margin-bottom: 12px;
    }

    .tasks-modal h3 {
        font-size: 23px;
        font-weight: 800;
        margin-bottom: 10px;
    }

    .tasks-modal p {
        color: #8990a5;
        font-size: 13px;
        line-height: 1.6;
    }

    .tasks-modal-actions {
        display: flex;
        justify-content: center;
        gap: 12px;
        margin-top: 25px;
    }

    /* TABLET */

    @@media (max-width: 1100px) {

        .tasks-stats {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .tasks-filters {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

            .tasks-filters input {
                grid-column: 1 / -1;
            }
    }

    /* MOBILE - IPHONE 16 AND SMALL SCREENS */

    @@media (max-width: 650px) {

        .tasks-page {
            width: 100%;
            max-width: 100%;
            min-width: 0;
            padding: 12px 0 25px;
        }
        /* HEADER */

        .tasks-header {
            flex-direction: column;
            align-items: flex-start;
            gap: 12px;
            margin-bottom: 20px;
        }

            .tasks-header h2 {
                font-size: 24px;
                margin-bottom: 6px;
            }

            .tasks-header p {
                font-size: 13px;
                line-height: 1.5;
            }

        .tasks-primary-button {
            padding: 10px 15px;
            font-size: 12px;
            border-radius: 10px;
        }
        /* TWO STATISTICS PER ROW */

        .tasks-stats {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 10px;
            margin-bottom: 20px;
        }

        .tasks-stat-card {
            min-width: 0;
            min-height: 0;
            padding: 12px 10px;
            gap: 9px;
            border-radius: 13px;
            display: flex;
            align-items: center;
        }

        .tasks-stat-icon {
            width: 34px;
            height: 34px;
            min-width: 34px;
            font-size: 18px;
            border-radius: 9px;
        }

        .tasks-stat-card > div {
            min-width: 0;
        }

        .tasks-stat-card small {
            font-size: 10px;
            line-height: 1.3;
        }

        .tasks-stat-card h3 {
            font-size: 23px;
            margin: 4px 0 0;
        }
        /* PANELS */

        .tasks-form-card,
        .tasks-list-card {
            width: 100%;
            min-width: 0;
            padding: 15px;
            border-radius: 16px;
            margin-bottom: 18px;
        }

        .tasks-section-header {
            margin-bottom: 15px;
        }

            .tasks-section-header h3 {
                font-size: 17px;
            }

            .tasks-section-header p {
                font-size: 11px;
            }
        /* FORM */

        .tasks-form-grid {
            grid-template-columns: minmax(0, 1fr);
            gap: 13px;
        }

        .tasks-field {
            min-width: 0;
            gap: 5px;
        }

            .tasks-field label {
                font-size: 12px;
            }

            .tasks-field .form-control,
            .tasks-field .form-select {
                width: 100%;
                min-width: 0;
                max-width: 100%;
                padding: 10px;
                font-size: 16px;
            }

        .full-width {
            grid-column: 1 / -1;
        }

        .tasks-form-actions {
            flex-wrap: wrap;
            gap: 8px;
            margin-top: 18px;
        }

            .tasks-form-actions button {
                flex: 1;
                min-width: 110px;
                padding: 10px;
                font-size: 12px;
            }
        /* FILTERS */

        .tasks-filters {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 8px;
            margin-bottom: 16px;
        }

            .tasks-filters input {
                grid-column: 1 / -1;
            }

            .tasks-filters .form-control,
            .tasks-filters .form-select {
                width: 100%;
                min-width: 0;
                max-width: 100%;
                padding: 9px;
                font-size: 12px;
            }
        /* TABLE BECOMES CARDS */

        .tasks-table-wrapper {
            width: 100%;
            max-width: 100%;
            overflow-x: visible;
        }

        .tasks-table {
            display: block;
            width: 100%;
            min-width: 0;
        }

            .tasks-table thead {
                display: none;
            }

            .tasks-table tbody {
                display: grid;
                grid-template-columns: minmax(0, 1fr);
                gap: 12px;
            }

                .tasks-table tbody tr {
                    display: grid;
                    grid-template-columns: repeat(2, minmax(0, 1fr));
                    gap: 9px;
                    padding: 13px;
                    border: 1px solid #eeedf8;
                    border-radius: 13px;
                    background: #fafaff;
                    min-width: 0;
                }

            .tasks-table td {
                display: block;
                min-width: 0;
                padding: 0;
                border: none;
                font-size: 11px;
