        cursor: pointer;
        box-shadow: 0 5px 15px rgba(102, 88, 245, 0.2);
    }

        .tasks-primary-button:hover {
            opacity: 0.9;
        }

        .tasks-primary-button:disabled {
            opacity: 0.6;
