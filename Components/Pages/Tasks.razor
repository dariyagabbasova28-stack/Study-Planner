@code {

    private readonly CultureInfo englishCulture =
        CultureInfo.GetCultureInfo("en-US");

    private List<TaskItem> tasks = new();

    private TaskItem taskForm = new();

    private string validationError = "";
    private string operationError = "";

    private bool isEditing = false;
    private bool showForm = false;

    private int? taskToDelete;

    private string searchText = "";
    private string statusFilter = "All";
    private string priorityFilter = "All";
    private string sortOrder = "DueSoon";

    protected override void OnInitialized()
    {
        LoadTasks();
        ResetForm();
    }

    private void LoadTasks()
    {
        tasks = TaskService.GetAll();
    }

    /* SEARCH, FILTER AND SORT */

    private IEnumerable<TaskItem> FilteredTasks
    {
        get
        {
            var result = tasks.Where(t =>
                (
                    string.IsNullOrWhiteSpace(searchText) ||
                    (t.Title?.Contains(
                        searchText,
                        StringComparison.OrdinalIgnoreCase) ?? false) ||
                    (t.Subject?.Contains(
                        searchText,
                        StringComparison.OrdinalIgnoreCase) ?? false) ||
                    (t.Description?.Contains(
                        searchText,
                        StringComparison.OrdinalIgnoreCase) ?? false)
                )
                &&
                (
                    statusFilter == "All" ||
                    t.Status.ToString() == statusFilter
                )
                &&
                (
                    priorityFilter == "All" ||
                    t.Priority.ToString() == priorityFilter
                )
            );

            return sortOrder switch
            {
                "DueLate" =>
                    result.OrderByDescending(t => t.DueDate),

                "Priority" =>
                    result.OrderByDescending(t => t.Priority),

                "Title" =>
                    result.OrderBy(t => t.Title),

                _ =>
                    result.OrderBy(t => t.DueDate)
            };
        }
    }

    /* SAVE TASK */

    private void SaveTask()
    {
        validationError = "";
        operationError = "";

        var result = ValidationService.ValidateTask(taskForm);

        if (!result.IsValid)
        {
            validationError = result.ErrorMessage;
            return;
        }

        try
        {
            if (isEditing)
            {
                TaskService.Update(taskForm);
            }
            else
            {
                TaskService.Add(taskForm);
            }

            LoadTasks();
            CancelEdit();
        }
        catch (Exception)
        {
            operationError =
                "Unable to save the task. Please try again.";
        }
    }

    /* ADD TASK */

    private void ShowAddForm()
    {
        validationError = "";
        operationError = "";

        ResetForm();

        isEditing = false;
        showForm = true;
    }

    /* EDIT TASK */

    private void EditTask(TaskItem task)
    {
        validationError = "";
        operationError = "";

        taskForm = new TaskItem
        {
            Id = task.Id,
            Title = task.Title,
            Subject = task.Subject,
            Description = task.Description,
            DueDate = task.DueDate,
            Priority = task.Priority,
            Status = task.Status
        };

        isEditing = true;
        showForm = true;
    }

    /* CANCEL EDIT */

    private void CancelEdit()
    {
        validationError = "";

        ResetForm();

        isEditing = false;
        showForm = false;
    }

    /* RESET FORM */

    private void ResetForm()
    {
        taskForm = new TaskItem
        {
            DueDate = DateTime.Today,
            Priority = StudyTaskPriority.Medium,
            Status = StudyTaskStatus.Pending
        };
    }

    /* DELETE TASK */

    private void RequestDelete(int id)
    {
        taskToDelete = id;
    }

    private void CancelDelete()
    {
        taskToDelete = null;
    }

    private void ConfirmDelete()
    {
        operationError = "";

        try
        {
            if (taskToDelete.HasValue)
            {
                TaskService.Delete(taskToDelete.Value);
                LoadTasks();
            }
        }
        catch (Exception)
        {
            operationError =
                "Unable to delete the task. Please try again.";
        }
        finally
        {
            taskToDelete = null;
        }
    }

    /* COMPLETE TASK */

    private void CompleteTask(int id)
    {
        operationError = "";

        try
        {
            TaskService.MarkCompleted(id);
            LoadTasks();
        }
        catch (Exception)
        {
            operationError =
                "Unable to complete the task. Please try again.";
        }
    }

    /* CHANGE STATUS */

    private void ChangeStatus(
        TaskItem task,
        StudyTaskStatus status)
    {
        var updatedTask = new TaskItem
        {
            Id = task.Id,
            Title = task.Title,
            Subject = task.Subject,
            Description = task.Description,
            DueDate = task.DueDate,
            Priority = task.Priority,
            Status = status
        };

        operationError = "";

        try
        {
            TaskService.Update(updatedTask);
            LoadTasks();
        }
        catch (Exception)
        {
            operationError =
                "Unable to update the task status. Please try again.";
        }
    }
}