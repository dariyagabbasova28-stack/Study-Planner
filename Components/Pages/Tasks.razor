        .tasks-form-grid,
        .tasks-filters {
            grid-template-columns: 1fr;
        }

        .tasks-form-card,
        .tasks-list-card {
            padding: 18px;
        }
    }

</style>

@code {

    private readonly CultureInfo englishCulture =
        CultureInfo.GetCultureInfo("en-US");

    private List<TaskItem> tasks = new();

    private TaskItem taskForm = new();

    private bool isEditing = false;
    private bool showForm = false;
    private bool isSaving = false;

    private int? taskToDelete;

    private string searchText = "";
    private string statusFilter = "All";
    private string priorityFilter = "All";
    private string sortOrder = "DueSoon";

    private string validationError = "";
    private string operationError = "";

    protected override void OnInitialized()
    {
        LoadTasks();
        ResetForm();
    }

    private void LoadTasks()
    {
        try
        {
            tasks = TaskService.GetAll();
        }
        catch (Exception)
        {
            operationError = "Unable to load tasks. Please try again.";
        }
    }

    private IEnumerable<TaskItem> FilteredTasks
    {
        get
        {
            var result = tasks.Where(t =>
                (string.IsNullOrWhiteSpace(searchText) ||
                 (t.Title?.Contains(searchText, StringComparison.OrdinalIgnoreCase) ?? false) ||
                 (t.Subject?.Contains(searchText, StringComparison.OrdinalIgnoreCase) ?? false) ||
                 (t.Description?.Contains(searchText, StringComparison.OrdinalIgnoreCase) ?? false))
                &&
                (statusFilter == "All" ||
                 t.Status.ToString() == statusFilter)
                &&
                (priorityFilter == "All" ||
                 t.Priority.ToString() == priorityFilter)
            );

            return sortOrder switch
            {
                "DueLate" => result.OrderByDescending(t => t.DueDate),
                "Priority" => result.OrderByDescending(t => t.Priority),
                "Title" => result.OrderBy(t => t.Title),
                _ => result.OrderBy(t => t.DueDate)
            };
        }
    }

    private void SaveTask()
    {
        if (isSaving)
            return;

        validationError = "";
        operationError = "";

        var result = ValidationService.ValidateTask(taskForm);

        if (!result.IsValid)
        {
            validationError = result.ErrorMessage;
            return;
        }

        isSaving = true;

        try
        {
            taskForm.Title = taskForm.Title.Trim();
            taskForm.Subject = taskForm.Subject.Trim();

            if (isEditing)
            {
                TaskService.Update(taskForm);
            }
            else
            {
                TaskService.Add(taskForm);
            }

            LoadTasks();
            CancelEdit();
        }
        catch (Exception)
        {
            operationError = "Unable to save the task. Please try again.";
        }
        finally
        {
            isSaving = false;
        }
    }

    private void ShowAddForm()
    {
        ResetForm();

        validationError = "";
        operationError = "";

        isEditing = false;
        showForm = true;
    }

    private void EditTask(TaskItem task)
    {
        validationError = "";
        operationError = "";

        taskForm = new TaskItem
        {
            Id = task.Id,
            Title = task.Title,
            Subject = task.Subject,
            Description = task.Description,
            DueDate = task.DueDate,
            Priority = task.Priority,
            Status = task.Status
        };

        isEditing = true;
        showForm = true;
    }

    private void CancelEdit()
    {
        ResetForm();

        validationError = "";

        isEditing = false;
        showForm = false;
    }

    private void ResetForm()
    {
        taskForm = new TaskItem
        {
            DueDate = DateTime.Today,
            Priority = StudyTaskPriority.Medium,
            Status = StudyTaskStatus.Pending
        };
    }

    private void RequestDelete(int id)
    {
        operationError = "";
        taskToDelete = id;
    }

    private void CancelDelete()
    {
        taskToDelete = null;
    }

    private void ConfirmDelete()
    {
        if (!taskToDelete.HasValue)
            return;

        try
        {
            TaskService.Delete(taskToDelete.Value);
            LoadTasks();

            taskToDelete = null;
        }
        catch (Exception)
        {
            operationError = "Unable to delete the task. Please try again.";
            taskToDelete = null;
        }
    }

    private void CompleteTask(int id)
    {
        operationError = "";

        try
        {
            TaskService.MarkCompleted(id);
            LoadTasks();
        }
        catch (Exception)
        {
            operationError = "Unable to complete the task. Please try again.";
        }
    }

    private void ChangeStatus(TaskItem task, StudyTaskStatus status)
    {
        operationError = "";

        var updatedTask = new TaskItem
        {
            Id = task.Id,
            Title = task.Title,
            Subject = task.Subject,
            Description = task.Description,
            DueDate = task.DueDate,
            Priority = task.Priority,
            Status = status
        };

        try
        {
            TaskService.Update(updatedTask);
            LoadTasks();
        }
        catch (Exception)
        {
            operationError = "Unable to update task status. Please try again.";
        }
    }
}