@code {

    private List<TaskItem> tasks = new();

    private List<PomodoroSession> sessions = new();

    private int TotalTasks => tasks.Count;

    private int CompletedTasks =>
        tasks.Count(t => t.Status == StudyTaskStatus.Completed);

    private int InProgressTasks =>
        tasks.Count(t => t.Status == StudyTaskStatus.InProgress);

    private int PendingTasks =>
        tasks.Count(t => t.Status == StudyTaskStatus.Pending);

    private int HighPriorityTasks =>
        tasks.Count(t => t.Priority == StudyTaskPriority.High);

    private int MediumPriorityTasks =>
        tasks.Count(t => t.Priority == StudyTaskPriority.Medium);

    private int LowPriorityTasks =>
        tasks.Count(t => t.Priority == StudyTaskPriority.Low);

    private int CompletedPercentage =>
        TotalTasks == 0
            ? 0
            : (int)Math.Round(CompletedTasks * 100.0 / TotalTasks);

    private int InProgressPercentage =>
        TotalTasks == 0
            ? 0
            : (int)Math.Round(InProgressTasks * 100.0 / TotalTasks);

    private string DonutStyle =>
        TotalTasks == 0
            ? "background: #f0eff8;"
            : $"background: conic-gradient(" +
              $"#22c55e 0% {CompletedPercentage}%," +
              $"#3b82f6 {CompletedPercentage}% " +
              $"{CompletedPercentage + InProgressPercentage}%," +
              $"#f59e0b {CompletedPercentage + InProgressPercentage}% 100%);";

    private int OverdueTasks =>
        tasks.Count(t =>
            t.DueDate.Date < DateTime.Today &&
            t.Status != StudyTaskStatus.Completed);

    private int DueTodayTasks =>
        tasks.Count(t =>
            t.DueDate.Date == DateTime.Today &&
            t.Status != StudyTaskStatus.Completed);

    private int UpcomingTasks =>
        tasks.Count(t =>
            t.DueDate.Date > DateTime.Today &&
            t.DueDate.Date <= DateTime.Today.AddDays(7) &&
            t.Status != StudyTaskStatus.Completed);

    private string SummaryMessage =>
        OverdueTasks > 0
            ? $"⚠️ You have {OverdueTasks} overdue tasks. Review your deadlines!"
            : DueTodayTasks > 0
                ? $"📌 You have {DueTodayTasks} tasks due today. Stay focused!"
                : "🎉 Great job! You have no overdue deadlines.";

    private List<SubjectStatistic> SubjectStats =>
        tasks
            .Where(t => !string.IsNullOrWhiteSpace(t.Subject))
            .GroupBy(t => t.Subject.Trim(), StringComparer.OrdinalIgnoreCase)
            .Select(g => new SubjectStatistic
            {
                Name = g.Key,
                Total = g.Count(),
                Completed = g.Count(t =>
                    t.Status == StudyTaskStatus.Completed)
            })
            .OrderBy(s => s.Name)
            .ToList();

    // POMODORO STATISTICS

    private int TotalPomodoros =>
        sessions.Count;

    private int TotalFocusMinutes =>
        sessions.Sum(s => s.DurationMinutes);

    private string FormattedFocusTime =>
        $"{TotalFocusMinutes / 60}h {TotalFocusMinutes % 60}m total";

    private int WeeklyFocusMinutes =>
        sessions
            .Where(s =>
                s.CompletedAt.Date >= DateTime.Today.AddDays(-6) &&
                s.CompletedAt.Date <= DateTime.Today)
            .Sum(s => s.DurationMinutes);

    private List<WeeklyDay> WeeklyActivity =>
        Enumerable.Range(0, 7)
            .Select(i =>
            {
                var date = DateTime.Today.AddDays(i - 6);

                return new WeeklyDay
                {
                    Date = date,
                    Label = date.ToString(
                        "ddd",
                        CultureInfo.GetCultureInfo("en-US")),

                    Minutes = sessions
                        .Where(s => s.CompletedAt.Date == date)
                        .Sum(s => s.DurationMinutes),

                    IsToday = date == DateTime.Today
                };
            })
            .ToList();

    private int StudyStreak
    {
        get
        {
            var studyDates = sessions
                .Select(s => s.CompletedAt.Date)
                .Distinct()
                .ToHashSet();

            var currentDate = DateTime.Today;

            if (!studyDates.Contains(currentDate))
                currentDate = currentDate.AddDays(-1);

            int streak = 0;

            while (studyDates.Contains(currentDate))
            {
                streak++;
                currentDate = currentDate.AddDays(-1);
            }

            return streak;
        }
    }

    private string ProductivityMessage =>
        TotalPomodoros == 0
            ? "Start your first focus session to begin tracking your productivity!"
            : StudyStreak >= 7
                ? "🔥 Amazing consistency! You've studied for at least 7 consecutive days."
                : StudyStreak >= 3
                    ? "🚀 Great progress! Keep your study streak going."
                    : WeeklyFocusMinutes >= 120
                        ? "💜 Great work! You've already studied for more than 2 hours this week."
                        : "🌱 Every focus session counts. Keep building your study habits!";

    protected override void OnInitialized()
    {
        LoadData();
    }

    private void LoadData()
    {
        tasks = TaskService.GetAll();
        sessions = PomodoroService.GetAll();
    }

    private int GetBarWidth(int count)
    {
        if (TotalTasks == 0)
            return 0;

        return (int)Math.Round(count * 100.0 / TotalTasks);
    }

    private int GetWeeklyBarHeight(int minutes)
    {
        if (minutes == 0)
            return 0;

        int maxMinutes = WeeklyActivity.Max(d => d.Minutes);

        if (maxMinutes == 0)
            return 0;

        return Math.Max(
            5,
            (int)Math.Round(minutes * 100.0 / maxMinutes));
    }

    private class SubjectStatistic
    {
        public string Name { get; set; } = "";

        public int Total { get; set; }

        public int Completed { get; set; }

        public int Progress =>
            Total == 0
                ? 0
                : (int)Math.Round(Completed * 100.0 / Total);
    }

    private class WeeklyDay
    {
        public DateTime Date { get; set; }

        public string Label { get; set; } = "";

        public int Minutes { get; set; }

        public bool IsToday { get; set; }
    }
}