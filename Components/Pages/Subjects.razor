@page "/subjects"
@rendermode InteractiveServer

@using StudyMate.Models
@using StudyMate.Services
@using System.Globalization

@inject TaskService TaskService

<PageTitle>Subjects - StudyMate</PageTitle>

<div class="subjects-page">

    <div class="subjects-header">
        <div>
            <h2>📚 My Subjects</h2>
            <p>Organize your courses and track your academic progress.</p>
        </div>

        <a href="/tasks" class="subjects-add-button">
            + Add Task
        </a>
    </div>

    <div class="subjects-stats">

        <div class="subjects-stat-card">
            <div class="subjects-stat-icon purple">📚</div>
            <div>
                <span>Total Subjects</span>
                <h3>@subjects.Count</h3>
            </div>
        </div>

        <div class="subjects-stat-card">
            <div class="subjects-stat-icon blue">📝</div>
            <div>
                <span>Total Tasks</span>
                <h3>@tasks.Count</h3>
            </div>
        </div>

        <div class="subjects-stat-card">
            <div class="subjects-stat-icon green">✅</div>
            <div>
                <span>Completed Tasks</span>
                <h3>@CompletedTasks</h3>
            </div>
        </div>

        <div class="subjects-stat-card">
            <div class="subjects-stat-icon orange">📊</div>
            <div>
                <span>Overall Progress</span>
                <h3>@OverallProgress%</h3>
            </div>
        </div>

    </div>

    <div class="subjects-toolbar">

        <div>
            <h3>Your Courses</h3>
            <p>Monitor assignments and completion rates.</p>
        </div>

        <div class="subjects-search">
            <span>🔍</span>
            <input type="text"
                   placeholder="Search subjects..."
                   @bind="searchText"
                   @bind:event="oninput" />
        </div>

    </div>

    @if (!subjects.Any())
    {
        <div class="subjects-empty">
            <div>📖</div>
            <h4>No subjects yet</h4>
            <p>Add your first task to start tracking your subjects.</p>

            <a href="/tasks" class="subjects-add-button">
                + Create Your First Task
            </a>
        </div>
    }
    else if (!FilteredSubjects.Any())
    {
        <div class="subjects-empty">
            <div>🔎</div>
            <h4>No matching subjects</h4>
            <p>Try searching for a different subject.</p>
        </div>
    }
    else
    {
        <div class="subjects-grid">

            @foreach (var subject in FilteredSubjects)
            {
                var subjectTasks = tasks
                .Where(t => string.Equals(
                t.Subject?.Trim(),
                subject,
                StringComparison.OrdinalIgnoreCase))
                .ToList();

                var total = subjectTasks.Count;

                var completed = subjectTasks.Count(
                t => t.Status == StudyTaskStatus.Completed);

                var pending = subjectTasks.Count(
                t => t.Status == StudyTaskStatus.Pending);

                var inProgress = subjectTasks.Count(
                t => t.Status == StudyTaskStatus.InProgress);

                var progress = total == 0
                ? 0
                : (int)Math.Round(completed * 100.0 / total);

                var isExpanded = expandedSubject == subject;

                <div class="subject-card">

                    <div class="subject-card-top">

                        <div class="subject-icon">
                            📖
                        </div>

                        <span class="subject-task-count">
                            @total Tasks
                        </span>

                    </div>

                    <h4>@subject</h4>

                    <p class="subject-description">
                        Track your assignments and deadlines.
                    </p>

                    <div class="subject-progress-header">
                        <span>Course Progress</span>
                        <strong>@progress%</strong>
                    </div>

                    <div class="subject-progress-track">
                        <div class="subject-progress-fill"
                             style="width: @(progress)%">
                        </div>
                    </div>

                    <div class="subject-details">

                        <div class="subject-detail">
                            <span class="detail-dot completed"></span>
                            <span>Completed</span>
                            <strong>@completed</strong>
                        </div>

                        <div class="subject-detail">
                            <span class="detail-dot inprogress"></span>
                            <span>In Progress</span>
                            <strong>@inProgress</strong>
                        </div>

                        <div class="subject-detail">
                            <span class="detail-dot pending"></span>
                            <span>Pending</span>
                            <strong>@pending</strong>
                        </div>

                    </div>

                    <button class="subject-view-button"
                            @onclick="() => ToggleSubject(subject)">

                        @(isExpanded ? "Hide Assignments ↑" : "View Assignments →")

                    </button>

                    @if (isExpanded)
                    {
                        <div class="subject-assignments">

                            <h5>📝 Assignments</h5>

                            @foreach (var task in subjectTasks.OrderBy(t => t.DueDate))
                            {
                                <div class="subject-assignment">

                                    <div class="assignment-main">
                                        <strong>@task.Title</strong>

                                        <small>
                                            📅 @task.DueDate.ToString(
                                                                        "dd MMM yyyy",
                                                                        CultureInfo.GetCultureInfo("en-US"))
                        </small>
                    </div>

                                    <div class="assignment-badges">

                                        <span class="assignment-priority priority-@task.Priority.ToString().ToLowerInvariant()">
                                            @task.Priority
                                        </span>

                                        <span class="assignment-status">
                                            @task.Status
                                        </span>

                                    </div>

                                </div>
                                }

                        </div>
                    }

                </div>
            }

        </div>
    }

</div>

<style>
    .subjects-page {
        padding: 15px 10px 40px;
        max-width: 1500px;
        margin: auto;
        color: #1e2440;
    }

    .subjects-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 30px;
        gap: 15px;
        flex-wrap: wrap;
    }

        .subjects-header h2 {
            font-size: 30px;
            font-weight: 800;
            margin-bottom: 8px;
        }

        .subjects-header p {
            color: #8990a5;
            margin: 0;
        }

    .subjects-add-button {
        background: linear-gradient(120deg, #6658f5, #9360f7);
        color: white;
        padding: 12px 22px;
        border-radius: 12px;
        text-decoration: none;
        font-weight: 700;
        display: inline-block;
        box-shadow: 0 5px 15px rgba(102, 88, 245, 0.2);
    }

        .subjects-add-button:hover {
            color: white;
            opacity: 0.9;
        }

    .subjects-stats {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 18px;
        margin-bottom: 35px;
    }

    .subjects-stat-card {
        background: white;
        border-radius: 18px;
        padding: 22px;
        display: flex;
        align-items: center;
        gap: 15px;
        box-shadow: 0 5px 25px rgba(30, 36, 64, 0.05);
    }

    .subjects-stat-icon {
        width: 55px;
        height: 55px;
        border-radius: 15px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 25px;
        flex-shrink: 0;
    }

        .subjects-stat-icon.purple {
            background: #f0eaff;
        }

        .subjects-stat-icon.blue {
            background: #e6f1ff;
        }

        .subjects-stat-icon.green {
            background: #dcfce7;
        }

        .subjects-stat-icon.orange {
            background: #fff0dc;
        }

    .subjects-stat-card span {
        font-size: 12px;
        color: #8990a5;
        font-weight: 600;
    }

    .subjects-stat-card h3 {
        font-size: 28px;
        font-weight: 800;
        margin: 5px 0 0;
    }

    .subjects-toolbar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        margin-bottom: 25px;
        flex-wrap: wrap;
    }

        .subjects-toolbar h3 {
            font-size: 23px;
            font-weight: 800;
            margin-bottom: 5px;
        }

        .subjects-toolbar p {
            color: #969bad;
            font-size: 13px;
            margin: 0;
        }

    .subjects-search {
        display: flex;
        align-items: center;
        gap: 10px;
        background: white;
        padding: 12px 18px;
        border-radius: 12px;
        box-shadow: 0 5px 20px rgba(30, 36, 64, 0.04);
        min-width: 260px;
    }

        .subjects-search input {
            border: none;
            outline: none;
            width: 100%;
            color: #1e2440;
            background: transparent;
        }

    .subjects-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 22px;
    }

    .subject-card {
        background: white;
        border-radius: 22px;
        padding: 26px;
        box-shadow: 0 5px 25px rgba(30, 36, 64, 0.05);
        transition: 0.2s;
        min-width: 0;
    }

        .subject-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 10px 30px rgba(102, 88, 245, 0.1);
        }

    .subject-card-top {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 20px;
    }

    .subject-icon {
        background: #f0eaff;
        width: 55px;
        height: 55px;
        border-radius: 15px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 27px;
    }

    .subject-task-count {
        background: #f0eaff;
        color: #6658f5;
        padding: 7px 12px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 700;
    }

    .subject-card h4 {
        font-size: 21px;
        font-weight: 800;
        margin-bottom: 8px;
        overflow-wrap: anywhere;
    }

    .subject-description {
        color: #969bad;
        font-size: 13px;
        margin-bottom: 25px;
    }

    .subject-progress-header {
        display: flex;
        justify-content: space-between;
        margin-bottom: 10px;
        font-size: 13px;
        font-weight: 600;
    }

        .subject-progress-header strong {
            color: #6658f5;
        }

    .subject-progress-track {
        width: 100%;
        height: 10px;
        background: #eeebff;
        border-radius: 20px;
        overflow: hidden;
        margin-bottom: 25px;
    }

    .subject-progress-fill {
        height: 100%;
        background: linear-gradient(90deg, #6658f5, #a477ff);
        border-radius: 20px;
        transition: width 0.3s ease;
    }

    .subject-details {
        display: flex;
        justify-content: space-between;
        gap: 10px;
        padding: 18px 0;
        border-top: 1px solid #f1eff8;
        border-bottom: 1px solid #f1eff8;
        margin-bottom: 20px;
    }

    .subject-detail {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 7px;
        font-size: 11px;
        color: #8990a5;
        text-align: center;
    }

        .subject-detail strong {
            font-size: 19px;
            color: #1e2440;
        }

    .detail-dot {
        width: 10px;
        height: 10px;
        border-radius: 50%;
    }

        .detail-dot.completed {
            background: #22c55e;
        }

        .detail-dot.inprogress {
            background: #3b82f6;
        }

        .detail-dot.pending {
            background: #f59e0b;
        }

    .subject-view-button {
        width: 100%;
        background: #f0eaff;
        color: #6658f5;
        border: none;
        padding: 13px;
        border-radius: 12px;
        font-weight: 700;
        cursor: pointer;
        transition: 0.2s;
    }

        .subject-view-button:hover {
            background: #6658f5;
            color: white;
        }

    .subject-assignments {
        margin-top: 22px;
        border-top: 1px solid #f1eff8;
        padding-top: 20px;
    }

        .subject-assignments h5 {
            font-size: 16px;
            font-weight: 800;
            margin-bottom: 15px;
        }

    .subject-assignment {
        background: #f8f9ff;
        padding: 14px;
        border-radius: 12px;
        margin-bottom: 10px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
    }

    .assignment-main {
        display: flex;
        flex-direction: column;
        gap: 7px;
        min-width: 0;
    }

        .assignment-main strong {
            font-size: 13px;
            overflow-wrap: anywhere;
        }

        .assignment-main small {
            color: #969bad;
            font-size: 11px;
        }

    .assignment-badges {
        display: flex;
        flex-direction: column;
        gap: 6px;
        flex-shrink: 0;
    }

    .assignment-priority,
    .assignment-status {
        padding: 6px 10px;
        border-radius: 8px;
        font-size: 11px;
        font-weight: 700;
        text-align: center;
    }

    .priority-high {
        background: #fee2e2;
        color: #dc2626;
    }

    .priority-medium {
        background: #fef3c7;
        color: #d97706;
    }

    .priority-low {
        background: #dcfce7;
        color: #16a34a;
    }

    .assignment-status {
        background: #eae5ff;
        color: #6658f5;
    }

    .subjects-empty {
        background: white;
        padding: 60px 25px;
        border-radius: 22px;
        text-align: center;
        box-shadow: 0 5px 25px rgba(30, 36, 64, 0.05);
    }

        .subjects-empty > div {
            font-size: 45px;
            margin-bottom: 15px;
        }

        .subjects-empty h4 {
            font-weight: 800;
        }

        .subjects-empty p {
            color: #969bad;
            margin-bottom: 25px;
        }

    @@media (max-width: 1100px) {
        .subjects-stats {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @@media (max-width: 750px) {
        .subjects-grid {
            grid-template-columns: 1fr;
        }

        .subjects-stats {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .subject-card {
            padding: 18px;
        }
    }
</style>

@code {
    private List<TaskItem> tasks = new();

    private List<string> subjects = new();

    private string searchText = "";

    private string? expandedSubject;

    private int CompletedTasks =>
        tasks.Count(t => t.Status == StudyTaskStatus.Completed);

    private int OverallProgress =>
        tasks.Count == 0
            ? 0
            : (int)Math.Round(CompletedTasks * 100.0 / tasks.Count);

    private List<string> FilteredSubjects =>
        subjects
            .Where(s =>
                string.IsNullOrWhiteSpace(searchText) ||
                s.Contains(searchText, StringComparison.OrdinalIgnoreCase))
            .ToList();

    protected override void OnInitialized()
    {
        tasks = TaskService.GetAll();

        subjects = tasks
            .Where(t => !string.IsNullOrWhiteSpace(t.Subject))
            .Select(t => t.Subject.Trim())
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(s => s)
            .ToList();
    }

    private void ToggleSubject(string subject)
    {
        if (expandedSubject == subject)
        {
            expandedSubject = null;
        }
        else
        {
            expandedSubject = subject;
        }
    }
}