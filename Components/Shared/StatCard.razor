<div class="shared-stat-card">
    <div class="shared-stat-icon">@Icon</div>

    <h3>@Value</h3>

    <p>@Title</p>

    @if (!string.IsNullOrWhiteSpace(Description))
    {
        <small>@Description</small>
    }
</div>

<style>
    .shared-stat-card {
        background: white;
        border-radius: 18px;
        padding: 25px;
        text-align: center;
        box-shadow: 0 5px 20px rgba(30, 36, 64, 0.05);
        height: 100%;
        min-width: 0;
        width: 100%;
        box-sizing: border-box;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
    }

    .shared-stat-icon {
        font-size: 30px;
        margin-bottom: 10px;
        line-height: 1.2;
    }

    .shared-stat-card h3 {
        font-size: 32px;
        font-weight: 800;
        color: var(--theme-primary, #6658f5);
        margin: 10px 0;
        max-width: 100%;
        overflow-wrap: anywhere;
    }

    .shared-stat-card p {
        color: #737c92;
        font-size: 13px;
        margin-bottom: 5px;
        line-height: 1.4;
        overflow-wrap: anywhere;
    }

    .shared-stat-card small {
        color: #8990a5;
        font-size: 11px;
        line-height: 1.4;
        overflow-wrap: anywhere;
    }

    /* TABLET */

    @@media (max-width: 900px) {

        .shared-stat-card {
            padding: 18px;
            border-radius: 15px;
        }

        .shared-stat-icon {
            font-size: 26px;
            margin-bottom: 8px;
        }

        .shared-stat-card h3 {
            font-size: 28px;
            margin: 7px 0;
        }

        .shared-stat-card p {
            font-size: 12px;
        }

        .shared-stat-card small {
            font-size: 10px;
        }
    }

    /* MOBILE */

    @@media (max-width: 600px) {

        .shared-stat-card {
            width: 100%;
            min-width: 0;
            min-height: 125px;
            height: 100%;
            padding: 12px 7px;
            border-radius: 13px;
            gap: 4px;
        }

        .shared-stat-icon {
            font-size: 23px;
            margin-bottom: 3px;
        }

        .shared-stat-card h3 {
            font-size: clamp(19px, 5.5vw, 25px);
            line-height: 1.2;
            margin: 3px 0;
        }

        .shared-stat-card p {
            font-size: 11px;
            font-weight: 600;
            line-height: 1.3;
            margin: 2px 0;
        }

        .shared-stat-card small {
            font-size: 9px;
            line-height: 1.35;
            margin-top: 2px;
        }
    }

    /* EXTRA SMALL PHONES */

    @@media (max-width: 350px) {

        .shared-stat-card {
            padding: 10px 5px;
            min-height: 115px;
        }

        .shared-stat-icon {
            font-size: 20px;
        }

        .shared-stat-card h3 {
            font-size: 19px;
        }

        .shared-stat-card p {
            font-size: 10px;
        }

        .shared-stat-card small {
            font-size: 9px;
        }
    }
</style>

@code {
    [Parameter] public string Icon { get; set; } = "📊";
    [Parameter] public string Value { get; set; } = "0";
    [Parameter] public string Title { get; set; } = "";
    [Parameter] public string Description { get; set; } = "";
}